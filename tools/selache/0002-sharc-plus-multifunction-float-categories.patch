+/// MUL/ALU 32/40-bit float multifunction, categories 011000..011111 (PGR Table 12-12): the multiply is
+/// always `Fm = F3-0 * F7-4` (the float multiplier has no MRF forms); the low three bits pick the ALU half.
+fn decode_mf_mul_alu_float(field: u32, mf_op: u32) -> String {
+    let fm = (field >> 12) & 0xF;
+    let fa = (field >> 8) & 0xF;
+    let fxm = (field >> 6) & 0x3;
+    let fym = ((field >> 4) & 0x3) + 4;
+    let fxa = ((field >> 2) & 0x3) + 8;
+    let fya = (field & 0x3) + 12;
+    let alu = match mf_op & 0x7 {
+        0b000 => format!("F{fa} = F{fxa} + F{fya}"),
+        0b001 => format!("F{fa} = F{fxa} - F{fya}"),
+        0b010 => format!("F{fa} = FLOAT R{fxa} BY R{fya}"),
+        0b011 => format!("R{fa} = FIX F{fxa} BY R{fya}"),
+        0b100 => format!("F{fa} = (F{fxa} + F{fya})/2"),
+        0b101 => format!("F{fa} = ABS F{fxa}"),
+        0b110 => format!("F{fa} = MAX(F{fxa}, F{fya})"),
+        _ => format!("F{fa} = MIN(F{fxa}, F{fya})"),
+    };
+    format!("F{fm} = F{fxm} * F{fym} , {alu}")
+}
