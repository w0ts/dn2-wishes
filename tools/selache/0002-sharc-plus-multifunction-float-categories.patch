+/// Does TEXT read as the ALU half of a multifunction (`Ra = Rxa op Rya`, an average, MIN, MAX), not a move or
+/// a transfer?
+fn is_mf_alu_text(text: &str) -> bool {
+    let Some(eq) = text.find('=') else { return false };
+    let rhs = &text[eq + 1..];
+    let moves = ["DM(", "PM(", "MODIFY", "BITREV"];
+    !moves.iter().any(|m| text.contains(m))
+        && (rhs.contains(" + ") || rhs.contains(" - ") || rhs.contains("MIN(") || rhs.contains("MAX("))
+}
